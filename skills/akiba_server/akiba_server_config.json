{
  "_meta": {
    "version": "1.0.0",
    "description": "Akiba Server 端点/凭据定位 - 供 LLM Agent 启动调用前必读"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "baseUrl": "http://127.0.0.1:8080",
    "apiBase": "/api",
    "healthCheck": "GET /api/health",
    "rootCheck": "GET /",
    "auth": {
      "defaultUsername": "akiba",
      "defaultPassword": "akiba123",
      "header": "Authorization: Bearer <token>",
      "instanceHeader": "X-Akiba-Instance"
    }
  },
  "daemon": {
    "host": "127.0.0.1",
    "port": 31777,
    "healthCheck": "GET /test"
  },
  "frontend": {
    "url": "http://localhost",
    "defaultInstance": "akiba-instance"
  },
  "endpoints": {
    "auth": {
      "register":  "POST /api/auth/register",
      "login":     "POST /api/auth/login",
      "logout":    "POST /api/auth/logout",
      "me":        "GET  /api/auth/me"
    },
    "instances": {
      "list":      "GET    /api/instances?probe=<name>",
      "create":    "POST   /api/instances/create",
      "delete":    "POST   /api/instances/delete",
      "start":     "POST   /api/instances/start",
      "shutdown":  "POST   /api/instances/shutdown",
      "backup":    "POST   /api/instances/backup"
    },
    "files": {
      "list":      "GET    /api/files?offset=0&limit=20",
      "search":    "GET    /api/files/search?q=<kw>",
      "import":    "POST   /api/files/import          (multipart)",
      "importStream":"GET  /api/files/import/stream/{taskId}",
      "delete":    "DELETE /api/files                 (JSON body: {fileIds:[]})"
    },
    "workflow": {
      "projects":     "GET  /api/workflow/projects",
      "start":        "POST /api/workflow/start",
      "stop":         "POST /api/workflow/stop/{id}",
      "status":       "GET  /api/workflow/status/{id}",
      "stream":       "GET  /api/workflow/stream/{id}",
      "running":      "GET  /api/workflow/running",
      "history":      "GET  /api/workflow/history",
      "logs":         "GET  /api/workflow/logs/{id}",
      "fileLogs":     "GET  /api/workflow/file-logs/{id}/{fileId}",
      "progressPost": "POST /api/progress              (子进程回调)"
    },
    "scripts": {
      "list":        "GET    /api/scripts?limit=100&offset=0&query=",
      "get":         "GET    /api/scripts/{id}",
      "create":      "POST   /api/scripts",
      "update":      "PUT    /api/scripts/{id}",
      "delete":      "DELETE /api/scripts/{id}",
      "run":         "POST   /api/scripts/{id}/run      (JSON: {binaryIds:[],parallel:true})",
      "executions":  "GET    /api/scripts/{id}/executions",
      "getExecution":"GET    /api/executions/{id}"
    },
    "query": {
      "execute":  "POST /api/query     (JSON: {sql,instanceName?})",
      "history":  "GET  /api/query/history"
    },
    "agent": {
      "listSessions":  "GET    /api/agent/sessions?limit=50&offset=0&parentSessionId=",
      "getSession":    "GET    /api/agent/sessions/{id}",
      "children":      "GET    /api/agent/sessions/{id}/children",
      "createSession": "POST   /api/agent/sessions",
      "messages":      "GET    /api/agent/sessions/{id}/messages",
      "chat":          "POST   /api/agent/sessions/{id}/chat  (JSON: {content, systemPrompt?})",
      "deleteSession": "DELETE /api/agent/sessions/{id}",
      "export":        "GET    /api/agent/sessions/{id}/export?scope=self|tree"
    },
    "skills": {
      "list":     "GET    /api/skills",
      "get":      "GET    /api/skills/{skillId}?maxChars=20000&path=",
      "getFile":  "GET    /api/skills/{skillId}/file?path=&maxChars=20000",
      "upload":   "POST   /api/skills/upload       (multipart, 必须 .zip)",
      "delete":   "DELETE /api/skills/{skillId}"
    },
    "projects": {
      "list":             "GET  /api/projects",
      "exportGar":        "GET  /api/projects/{name}/export             (application/zip → .gar)",
      "exportTextStatus": "GET  /api/projects/{name}/export_text/status",
      "exportText":       "POST /api/projects/{name}/export_text        (application/zip → listing/decompile/comments zip)"
    },
    "llm": {
      "providers": "GET    /api/llm/providers",
      "keys":      "GET    /api/llm/keys",
      "addKey":    "POST   /api/llm/keys",
      "deleteKey": "DELETE /api/llm/keys?provider=&modelName=",
      "models":    "GET    /api/llm/models?provider=&apiKey=&baseUrl="
    },
    "runtimeConfigs": {
      "list":   "GET    /api/runtime-configs",
      "get":    "GET    /api/runtime-configs/{name}",
      "save":   "PUT    /api/runtime-configs",
      "delete": "DELETE /api/runtime-configs/{name}"
    }
  },
  "scripts_local": {
    "garToListing": "scripts/gar_listing_to_markdown.py"
  },
  "sizeLimits": {
    "fileUploadTotal": "100 MB",
    "scriptCode": "1 MB",
    "scriptOutput": "10 MB",
    "skillUpload": "无显式上限，建议 < 50 MB"
  },
  "examples": {
    "login": "curl -s -X POST $BASE/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"$U\",\"password\":\"$P\"}'",
    "listSessions": "curl -s $BASE/api/agent/sessions -H \"Authorization: Bearer $T\" -H \"X-Akiba-Instance: $I\"",
    "garExport": "curl -s $BASE/api/projects/$NAME/export -H \"Authorization: Bearer $T\" -o $NAME.gar",
    "textExportStatus": "curl -s $BASE/api/projects/$NAME/export_text/status -H \"Authorization: Bearer $T\" -H \"X-Akiba-Instance: $I\"",
    "textExport": "curl -s -X POST $BASE/api/projects/$NAME/export_text -H \"Authorization: Bearer $T\" -H \"X-Akiba-Instance: $I\" -H 'Content-Type: application/json' -d '{\"contents\":[\"listing\",\"comments\",\"functions\"],\"includeDecompile\":false}' -o $NAME-export_text.zip"
  }
}
